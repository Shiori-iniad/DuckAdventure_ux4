MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2038717458}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0ec13d74f81f4804fa284f1c6a749f51, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  player: {fileID: 1967200116}
  duckTalk: {fileID: 1163766764}
  talkJump:
    lines:
    - "\u3088\u30FC\u3057\uFF01\u305D\u308C\u3058\u3083\u3042\u3001\u30C1\u30E5\u30FC\u30C8\u30EA\u30A2\u30EB\u3092\u59CB\u3081\u308B\u305E\uFF01"
    - "\u307E\u305A\u306F\u64CD\u4F5C\u65B9\u6CD5\u306E\u8AAC\u660E\u3060\u3002"
    - "\u64CD\u4F5C\u65B9\u6CD5\u306F\u3068\u3063\u3066\u3082\u7C21\u5358\uFF01"
    - "\u30B9\u30DA\u30FC\u30B9\u30AD\u30FC\u3092\u62BC\u3057\u3066\u30B8\u30E3\u30F3\u30D7\uFF01"
    - "\u3055\u3089\u306B\uFF01\u30B8\u30E3\u30F3\u30D7\u4E2D\u306B\u3082\u3046\u4E00\u56DE\u30B9\u30DA\u30FC\u30B9\u30AD\u30FC\u3092\u62BC\u3059\u3068..."
    - "2\u6BB5\u30B8\u30E3\u30F3\u30D7\u304C\u3067\u304D\u308B\uFF01"
    - "\u30B8\u30E3\u30F3\u30D7\u306F\u6700\u5927\u30672\u6BB5\u307E\u3067\u3060\u3002"
    - "\u98DB\u3073\u3059\u304E\u6CE8\u610F\u3060\u304B\u3089\u306A\u3002"
    - "\u305D\u308C\u3058\u3083\u3042\u5B9F\u8DF5\u3060\uFF01"
    - "\u76EE\u306E\u524D\u306B2\u3064\u306E\u969C\u5BB3\u7269\u304C\u3042\u308B\u304B\u3089\u30B8\u30E3\u30F3\u30D7\u3067\u8D85\u3048\u3066\u307F\u3088\u3046\uFF01"
  talkCoin:
    lines:
    - "\u6B21\u306F\u3001\u30B3\u30A4\u30F3\u306E\u8AAC\u660E\u3060\u3002"
    - "\u3053\u306E\u30B9\u30C6\u30FC\u30B8\u306B\u3042\u308B\u30B3\u30A4\u30F3\u306B\u89E6\u308C\u308B\u3068\u3001\u30B2\u30C3\u30C8\u3067\u304D\u308B\u305E\uFF01"
    - "\u30B7\u30EB\u30D0\u30FC\u30B3\u30A4\u30F3\u306F1pt\u3001\u30B4\u30FC\u30EB\u30C9\u30B3\u30A4\u30F3\u306F5pt\u3060\u3002"
    - "\u305F\u304F\u3055\u3093\u96C6\u3081\u3066\u304A\u304F\u3068\u3001\u5F8C\u3005\u3044\u3044\u3053\u3068\u304C\u3042\u308B\u304B\u3082\u3057\u308C\u306A\u3044\u305E\uFF01"
    - "\u305F\u3060\u3057\u6CE8\u610F\u3060\u3002"
    - "GameOver\u306B\u306A\u3063\u3061\u3083\u3046\u3068\u3001\u96C6\u3081\u305F\u30B3\u30A4\u30F3\u306F\u5168\u90E8\u306A\u304F\u306A\u308B..."
    - "\u3060\u304B\u3089\u3001GameClear\u3092\u76EE\u6307\u3057\u3064\u3064\u3001\u3046\u307E\u304F\u96C6\u3081\u3066\u3044\u3053\u3046\uFF01"
    - "\u305D\u308C\u3058\u3083\u3042\u5B9F\u8DF5\u3060\uFF01"
    - "\u53F3\u4E0A\u306E\u8868\u793A\u306B\u3082\u6CE8\u76EE\u3057\u306A\u304C\u3089\u3001\u30B3\u30A4\u30F3\u3092\u96C6\u3081\u3066\u307F\u3088\u3046\uFF01"
  talkGoal:
    lines:
