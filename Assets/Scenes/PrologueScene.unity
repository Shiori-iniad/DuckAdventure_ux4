  dialogues:
  - "\u307C\u304F\u306E\u540D\u524D\u306F\u3001\u30AF\u30EF\u30C3\u30D5\u30A3\u30FC\uFF01"
  - "\u3044\u305F\u305A\u3089\u304C\u5927\u597D\u304D\u306A\u3001\u3061\u3087\u3063\u3068\u304A\u8ABF\u5B50\u8005\u306E\u3042\u3072\u308B\u3055\uFF01"
  - "\u3076\u3089\u3076\u3089\u6563\u6B69\u3057\u306A\u304C\u3089\u3001\u3044\u308D\u3093\u306A\u5730\u57DF\u3092\u5192\u967A\u3057\u3066\u3044\u308B\u3093\u3060\u3002"
